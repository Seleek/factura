@page "/"
@using factura.Components.Data
@using factura.Components.Servicios
@inject LlenarFactura LlenarFactura
@inject ServicioControlador ServicioControlador
@rendermode InteractiveServer

<PageTitle>Facturas</PageTitle>

<head>
	<title>Bootstrap Tables</title>
	<meta charset="utf-8">
	<meta name="viewport"
		  content="width=device-width, initial-scale=1">
	<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
	<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js">
	</script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js">
	</script>
	<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js">
	</script>
</head>
<body>
<h1>FACTURAS</h1>

<div class="card shadow-sm mt-4">
	<div class="card-header">
		<h1 style="text-align:center;color:brown;">
			Lista de facturas
		</h1>
	</div>
	<div>
		<input type="date" @bind="nuevaFactura.Fecha" placeholder="Fecha de factura"/>
		<input @bind="nuevaFactura.Nombre" placeholder="Nombre del cliente"/>
		<input @bind="nuevaFactura.Articulo" placeholder="Articulo"/>
		<input type="number" @bind="nuevaFactura.Precio" placeholder="Precio"/>
			<!-- <button @onclick="AgregarFactura">Agregar Factura</button> -->
	</div>
</div>
<table class="table">
	<thead class="table-dark">
		<tr>
			<th scope="col">ID</th>
			<th scope="col">FECHA</th>
			<th scope="col">NOMBRE</th>
			<th scope="col">ARTICULO</th>
			<th class="text-end">PRECIO</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var factura in facturas)
		{
			<tr>
				<td scope="col">@factura.Identificador</td>
				<td>@factura.Fecha.ToString()</td>
				<td>@factura.Nombre</td>
				<td>@factura.Articulo</td>
				<td class="text-end">@factura.Precio.ToString("C")</td>
			</tr>
		}
		<tr>
			<td scope="col" colspan="4" style="text-align:end">TOTAL</td>
			<td class="text-end">23456</td>
		</tr>
	</tbody>
</table>
</body>




@code{
	private List<Factura> facturas = new();
	private Factura nuevaFactura = new();

	protected override async Task OnInitializedAsync()
	{
		facturas = await ServicioControlador.ObtenerFacturas();
	}
}