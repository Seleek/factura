@page "/"
@using factura.Components.Data
@using factura.Components.Servicios
@inject LlenarFactura LlenarFactura
@inject ServicioControlador ServicioControlador
@rendermode InteractiveServer

<PageTitle>Facturas</PageTitle>

<h1>FACTURAS</h1>

<div class="card shadow-sm mt-4">
	<div class="card-header">
		<h5 class="mb-0">Lista de Facturas</h5>
	</div>
</div>
<table class="table table-striped table-hover mb-0 align-middle">
	<thead class="table-dark">
		<tr>
			<th class="text-end">ID</th>
			<th>FECHA</th>
			<th>NOMBRE</th>
			<th>ARTICULO</th>
			<th class="text-end">PRECIO</th>
		</tr>
	</thead>
	<trbody>
		@foreach (var factura in facturas)
		{
			<tr>
				<td class="text-end">@factura.Identificador</td>
				<td>@factura.Fecha.ToString("f")</td>
				<td>@factura.Nombre</td>
				<td>@factura.Articulo</td>
				<td class="text-end">@factura.Precio.ToString("C")</td>
			</tr>
		}
	</trbody>
</table>



@code{
	private List<Factura> facturas = new();
	private Factura nuevaFactura = new();

	protected override async Task OnInitializedAsync()
	{
		facturas = await ServicioControlador.ObtenerFacturas();
	}
}